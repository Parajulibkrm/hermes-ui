# Copy to .env (or paste these into Dokploy's env-var UI).

# ---- Web UI exposure ----
# Public hostname Traefik routes to the dashboard (no scheme, no port).
# Example: hermes.example.com
HERMES_DOMAIN=

# ---- Image pin (optional) ----
# Override to pin a specific tag instead of `latest`.
HERMES_IMAGE=nousresearch/hermes-agent:latest
