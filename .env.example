# Copy to .env (or paste these into Dokploy's env-var UI).

# ---- Web UI exposure ----
# Public hostname Traefik routes to the dashboard (no scheme, no port).
# Example: hermes.example.com
HERMES_DOMAIN=

# ---- Image pin (optional) ----
# Override to pin a specific tag instead of `latest`.
HERMES_IMAGE=nousresearch/hermes-agent:latest

# ---- Dashboard basic auth (REQUIRED if HERMES_DOMAIN is public) ----
# Hermes dashboard has no native auth and reads/writes the volume that holds
# your API keys, so Traefik enforces basic auth in front of it.
#
# Generate one or more user:hash entries with `htpasswd`:
#   htpasswd -nb admin 'your-strong-password'
# (On Debian/Ubuntu: `apt install apache2-utils`. On macOS: comes with httpd.)
#
# Paste the FULL output below (no quotes). Multiple users: comma-separate.
# Compose passes this value through verbatim — no $$ escaping needed in .env.
# If left empty, Traefik will reject every request to ${HERMES_DOMAIN} (safe
# default — fail closed).
HERMES_DASHBOARD_BASICAUTH=

# ---- Community WebUI (nesquena/hermes-webui) ----
# Public hostname Traefik routes to the community WebUI on :8787.
# Must be a different subdomain from HERMES_DOMAIN. Leave blank to skip the
# `webui` service's Traefik routing (the container still runs and is reachable
# from inside dokploy-network).
HERMES_WEBUI_DOMAIN=

# Optional: override the UID/GID the WebUI container runs as. Defaults to
# 10000 to match the `hermes` user in nousresearch/hermes-agent so all three
# services can share the /opt/data volume.
# HERMES_WEBUI_UID=10000
# HERMES_WEBUI_GID=10000

# Optional: password-protect the WebUI. Recommended if HERMES_WEBUI_DOMAIN is
# public. Leave blank for no auth (only safe behind VPN/SSH tunnel).
HERMES_WEBUI_PASSWORD=
